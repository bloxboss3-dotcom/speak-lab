// Copy this file to Secrets.xcconfig (same folder) and fill it in.
// Secrets.xcconfig is gitignored and never committed.
//
// Both values are optional. Leave them blank and the app runs on its
// on-device coach; you can also set them later in Settings inside the app,
// which stores them in the Keychain instead of the bundle.
//
// NOTE ON URLs: xcconfig treats "//" as a comment, even inside a value. Write
// the URL without the scheme's slashes and let the app add them back, or use
// the in-app Settings screen instead — which is the easier path.
//   SPEAKLAB_PROXY_URL = https:/$()/proxy.example.com
// The $() is an empty variable that breaks up the "//" so it survives.

SPEAKLAB_PROXY_URL =
SPEAKLAB_PROXY_SECRET =
