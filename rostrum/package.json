{
  "name": "rostrum",
  "private": true,
  "version": "0.1.0",
  "description": "Deliberate practice for speakers: learn a technique from a great communicator, use it today, retrieve it cold days later.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "npm run check:static && ROSTRUM_STATIC=1 NEXT_PUBLIC_ROSTRUM_STATIC=1 next build",
    "check:static": "node scripts/check-static.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
