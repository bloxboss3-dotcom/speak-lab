# Copy to .env.local and fill in. .env* is gitignored except this file.
#
# Rostrum runs fully without any of this. With no key the app coaches from its
# offline evaluator, which scores against each technique's text markers, detects
# unprompted retrieval and labels every result "Offline coaching" on screen.
# The key buys judgement about the words, not the mechanics.

# Optional. Get one at https://console.anthropic.com/settings/keys
# Read only by the server route at src/app/api/coach/route.ts. It is never sent
# to the browser — do not add a NEXT_PUBLIC_ prefix to it, ever.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-sonnet-5.
# Coaching sits in the middle of a practice loop, so latency is part of the
# product: a learner waiting fifteen seconds between reps stops doing reps.
# claude-opus-5 judges more finely if you would rather trade speed for depth.
ROSTRUM_MODEL=claude-sonnet-5

# Set by `npm run build:static`; you do not normally set these by hand.
# ROSTRUM_STATIC=1 swaps the server build for a folder of files, which drops
# /api/coach — there is no server to hold a key in that mode.
# NEXT_PUBLIC_ROSTRUM_STATIC=1 tells the screens the same thing, so the Profile
# screen states there is no server rather than describing coaching it cannot do.
# ROSTRUM_BASE_PATH is the sub-path a static build is served from, e.g.
# /speak-lab/rostrum for a GitHub Pages project site.
