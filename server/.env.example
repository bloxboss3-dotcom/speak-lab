# Copy to .env and fill in. .env is gitignored.

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended once this is reachable from the internet: a shared
# secret the iOS app sends in the x-speaklab-key header. Without it, anyone
# who learns the URL can spend your API credits.
# Generate one with:  openssl rand -hex 32
SPEAKLAB_CLIENT_SECRET=

# Optional overrides
PORT=8787
# claude-opus-5 is the default and gives the best coaching judgement.
# claude-sonnet-5 is noticeably faster and cheaper if you'd rather trade some
# quality for latency on every attempt.
SPEAKLAB_MODEL=claude-opus-5
SPEAKLAB_MAX_TOKENS_CEILING=8000
SPEAKLAB_RPM=40
SPEAKLAB_TIMEOUT_MS=120000
# Rescue safety-classifier refusals on a fallback model instead of failing.
SPEAKLAB_REFUSAL_FALLBACK=true
